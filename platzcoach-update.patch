+let PWFLOW={mode:null,state:'form',error:'',code:null};
+function pwResetEnabled(){ return !!(CFG&&CFG.passwordReset&&CFG.passwordReset.workerUrl); }
+async function pwApi(path,body){
+  const base=String(CFG.passwordReset.workerUrl||'').replace(/\/+$/,'');
+  let r;
+  try{ r=await fetch(base+path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body),cache:'no-store'}); }
+  catch(e){ throw new Error('Keine Verbindung zum Server. Bitte Internetverbindung prüfen.'); }
+  let data={}; try{ data=await r.json(); }catch(e){}
+  if(!r.ok) throw new Error(data.error||('Server antwortet mit Fehler '+r.status+'.'));
+  return data;

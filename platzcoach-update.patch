diff --git a/.github/workflows/password-mails.yml b/.github/workflows/password-mails.yml
new file mode 100644
index 0000000..6279529
--- /dev/null
+++ b/.github/workflows/password-mails.yml
@@ -0,0 +1,40 @@
+name: Passwort-Mails (Reset-Link, Bestätigung)
+
+# Nur per repository_dispatch – ausgelöst vom Passwort-Worker ("password-reset-link") bzw. von
+# der App nach einer Passwortänderung ("password-changed"). Der Reset-Link landet so nie in
+# einer Datei oder Commit-Nachricht.
+
+on:
+  repository_dispatch:
+    types: [password-reset-link, password-changed]
+
+jobs:
+  send:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+
+      - name: Abhängigkeiten installieren
+        run: npm install --no-audit --no-fund
+
+      - name: Link für Logs maskieren
+        if: github.event.action == 'password-reset-link'
+        env:
+          LINK: ${{ github.event.client_payload.link }}
+        run: echo "::add-mask::$LINK"
+
+      - name: E-Mail senden
+        env:
+          SMTP_HOST: ${{ secrets.SMTP_HOST }}
+          SMTP_PORT: ${{ secrets.SMTP_PORT }}
+          SMTP_USER: ${{ secrets.SMTP_USER }}
+          SMTP_PASS: ${{ secrets.SMTP_PASS }}
+          MAIL_TYPE: ${{ github.event.action }}
+          PAYLOAD_NAME: ${{ github.event.client_payload.name }}
+          PAYLOAD_EMAIL: ${{ github.event.client_payload.email }}
+          PAYLOAD_LINK: ${{ github.event.client_payload.link }}
+        run: node scripts/send-password-mail.mjs
